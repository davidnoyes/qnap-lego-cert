# LegoCert configuration template. The live file is <install dir>/legocert.conf (created
# from this on first install, never replaced by upgrades). Must be root:root 0600.
# Read as KEY=VALUE data, never executed: one setting per line, no trailing
# comments. Any other KEY is a credential for the DNS provider, under lego's own
# variable name (`lego dnshelp --code <provider>`); one the provider doesn't use
# is an error.

# Name the QTS web UI is reached by, e.g. nas.example.com (set in the settings page).
DOMAIN=

# ACME account contact.
EMAIL=

# DNS provider: a lego provider code. The settings page offers cloudflare, duckdns,
# porkbun, route53, digitalocean, hetzner, ovh, gandiv5 and desec with setup steps.
DNS_PROVIDER=cloudflare

# Its credentials, e.g. for Cloudflare an API token (starts cfut_) with DNS Edit +
# Zone Read, limited to ONE zone (docs/cloudflare-token.md in the source repo;
# check it with ./renew.sh --check-token). Optionally a separate Zone Read token
# in CLOUDFLARE_ZONE_API_TOKEN.
#CLOUDFLARE_DNS_API_TOKEN=

# Optional overrides (defaults shown).
# ACME server: lego shortcode or ACME directory URL.
#ACME_SERVER=letsencrypt
# Resolvers for lego's DNS lookups, bypassing the LAN resolver's rewrites.
#DNS_RESOLVERS=1.1.1.1:53,1.0.0.1:53
# QTS HTTPS port; by default read from QTS's own settings.
#HTTPS_PORT=443
